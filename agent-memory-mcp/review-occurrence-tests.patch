diff --git a/internal/memory/review_occurrence_test.go b/internal/memory/review_occurrence_test.go
new file mode 100644
--- /dev/null
+++ b/internal/memory/review_occurrence_test.go
@@ -0,0 +1,93 @@
+package memory
+
+import (
+ "context"
+ "testing"
+ "sync"
+)
+
+func reviewOccurrenceFixture() *Memory {
+ return &Memory{
+  Title: "Review proposal",
+  Content: "Complete proposal content",
+  Type: TypeWorking,
+  Context: "maison-cognitive",
+  Importance: 0.5,
+  Tags: []string{"review:required","review-queue"},
+  Metadata: map[string]string{MetadataRecordKind: RecordKindReviewQueueItem},
+ }
+}
+
+func TestReviewOccurrenceDeduplicatesAndProtectsDecision(t *testing.T) {
+ store:=newTestStore(t)
+ ctx:=context.Background()
+ first:=reviewOccurrenceFixture()
+ id,count,err:=store.StoreReviewOccurrence(ctx,"fingerprint-A",first)
+ if err!=nil {t.Fatal(err)}
+ if id=="" || count!=1 {t.Fatalf("first occurrence id=%q count=%d",id,count)}
+ second:=reviewOccurrenceFixture()
+ secondID,count,err:=store.StoreReviewOccurrence(ctx,"fingerprint-A",second)
+ if err!=nil {t.Fatal(err)}
+ if secondID!=id || count!=2 {t.Fatalf("duplicate id=%q count=%d, expected %q,2",secondID,count,id)}
+ var records int
+ if err:=store.db.QueryRowContext(ctx,"SELECT count(*) FROM memories WHERE id=?",id).Scan(&records);err!=nil {t.Fatal(err)}
+ if records!=1 {t.Fatalf("expected one memory row, got %d",records)}
+
+ // A different fingerprint is a different proposal even if title is equal.
+ distinctID,distinctCount,err:=store.StoreReviewOccurrence(ctx,"fingerprint-B",reviewOccurrenceFixture())
+ if err!=nil {t.Fatal(err)}
+ if distinctID==id || distinctCount!=1 {t.Fatal("different proposal was merged")}
+
+ // Simulate the existing review-resolution write path: no reopen by repetition.
+ if _,err:=store.db.ExecContext(ctx,`UPDATE memories SET tags='["review:resolved"]' WHERE id=?`,id);err!=nil {t.Fatal(err)}
+ if _,_,err:=store.StoreReviewOccurrence(ctx,"fingerprint-A",reviewOccurrenceFixture());err==nil {
+  t.Fatal("resolved review must not be reopened or incremented")
+ }
+ var got int
+ if err:=store.db.QueryRowContext(ctx,"SELECT seen_count FROM review_occurrence_links WHERE fingerprint='fingerprint-A'").Scan(&got);err!=nil {t.Fatal(err)}
+ if got!=2 {t.Fatalf("resolved review count changed to %d",got)}
+}
+func TestReviewOccurrenceDecisionStates(t *testing.T) {
+ for _,state:=range []string{"review:resolved","review:dismissed","review:deferred"} {
+  t.Run(state,func(t *testing.T){
+   store:=newTestStore(t)
+   ctx:=context.Background()
+   id,_,err:=store.StoreReviewOccurrence(ctx,"decision-key",reviewOccurrenceFixture())
+   if err!=nil {t.Fatal(err)}
+   if _,err:=store.db.ExecContext(ctx,`UPDATE memories SET tags=? WHERE id=?`,"[\""+state+"\"]",id);err!=nil {t.Fatal(err)}
+   if _,_,err:=store.StoreReviewOccurrence(ctx,"decision-key",reviewOccurrenceFixture());err==nil {t.Fatal("decision was reopened")}
+   var count int
+   if err:=store.db.QueryRowContext(ctx,`SELECT seen_count FROM review_occurrence_links WHERE fingerprint=?`,"decision-key").Scan(&count);err!=nil {t.Fatal(err)}
+   if count!=1 {t.Fatalf("decision count changed: %d",count)}
+  })
+ }
+}
+
+func TestReviewOccurrenceConcurrentSameStore(t *testing.T) {
+ store:=newTestStore(t)
+ const workers=12
+ var wg sync.WaitGroup
+ errs:=make(chan error,workers)
+ ids:=make(chan string,workers)
+ for i:=0;i<workers;i++ {
+  wg.Add(1)
+  go func(){
+   defer wg.Done()
+   id,_,err:=store.StoreReviewOccurrence(context.Background(),"same-proposal",reviewOccurrenceFixture())
+   if err!=nil {errs<-err;return}
+   ids<-id
+  }()
+ }
+ wg.Wait()
+ close(errs)
+ close(ids)
+ for err:=range errs {t.Fatal(err)}
+ var first string
+ for id:=range ids {
+  if first=="" {first=id}
+  if id!=first {t.Fatalf("concurrent duplicate: %q vs %q",id,first)}
+ }
+ var count int
+ if err:=store.db.QueryRow(`SELECT seen_count FROM review_occurrence_links WHERE fingerprint=?`,"same-proposal").Scan(&count);err!=nil {t.Fatal(err)}
+ if count!=workers {t.Fatalf("count=%d, want %d",count,workers)}
+}
