@@ -12,6 +12,19 @@ const (
 	MetadataService         = "service"
 	MetadataSeverity        = "severity"
 	MetadataStatus          = "status"
+	// MetadataSupersededPermanently freezes a replacement: when the successor
+	// disappears, the predecessor must not silently become current again.
+	MetadataSupersededPermanently = "superseded_permanently"
+	// MetadataEvergreen marks knowledge that does not age out. It is an
+	// explicit editorial decision recorded on the record, never inferred from
+	// its type: a rule can be stable while another fact of the same type is not.
+	MetadataEvergreen = "evergreen"
+	// MetadataDecisionRef carries the DEC-* reference that justified a
+	// replacement or a revocation, so the pair stays auditable.
+	MetadataDecisionRef = "decision_ref"
+	// MetadataValidityState is set on as_of results only: confirmed when a
+	// valid_from is recorded, undetermined when the effective date is unknown.
+	MetadataValidityState = "validity_state"
 	MetadataLifecycleStatus = "lifecycle_status"
