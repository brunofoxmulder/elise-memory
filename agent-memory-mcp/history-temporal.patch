new file mode 100644
index 0000000..ddd76fe
--- /dev/null
+++ b/internal/memory/history_bench_test.go
@@ -0,0 +1,56 @@
+package memory
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+)
+
+// BenchmarkHistoryRecall measures the cost the new gates add to a recall on a
+// corpus of 200 records. Two cases isolate it: the default path runs the
+// supersession, retired-status and validity-window checks per candidate;
+// include_expired short-circuits the last two, so the delta is their cost.
+func BenchmarkHistoryRecall(b *testing.B) {
+	dbPath := b.TempDir() + "/bench.db"
+	store, err := NewStore(dbPath, nil, nil)
+	if err != nil {
+		b.Fatalf("NewStore: %v", err)
+	}
+	defer func() { _ = store.Close() }()
+
+	ctx := context.Background()
+	base := time.Date(2026, 3, 1, 9, 0, 0, 0, time.UTC)
+	store.SetClock(func() time.Time { return base })
+
+	for i := 0; i < 200; i++ {
+		m := &Memory{
+			Content:    fmt.Sprintf("regle de test numero %d sur le volet du salon et son seuil", i),
+			Type:       TypeSemantic,
+			Importance: 0.7,
+		}
+		if i%10 == 0 {
+			m.Metadata = map[string]string{MetadataEvergreen: "true"}
+		}
+		if err := store.Store(ctx, m); err != nil {
+			b.Fatalf("Store: %v", err)
+		}
+	}
+
+	cases := []struct {
+		name    string
+		filters Filters
+	}{
+		{"default_gates", Filters{}},
+		{"include_expired", Filters{IncludeExpired: true}},
+	}
+	for _, c := range cases {
+		b.Run(c.name, func(b *testing.B) {
+			for i := 0; i < b.N; i++ {
+				if _, err := store.Recall(ctx, "seuil du volet du salon", c.filters, 5); err != nil {
+					b.Fatalf("Recall: %v", err)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/memory/history_temporal_test.go b/internal/memory/history_temporal_test.go
new file mode 100644
index 0000000..8be5ee2
--- /dev/null
+++ b/internal/memory/history_temporal_test.go
@@ -0,0 +1,444 @@
+package memory
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+)
+
+// Tests for the history/temporality layer (C1–C7). They pin the behaviour the
+// Maison Cognitive governance requires: an old fact is never declared false
+// because of its age, a replaced record is never silently deleted, and a
+// withdrawn decision stays readable.
+
+var (
+	histT0 = time.Date(2026, 3, 1, 9, 0, 0, 0, time.UTC)  // knowledge captured
+	histT1 = time.Date(2026, 4, 1, 9, 0, 0, 0, time.UTC)  // rule evolves
+	histT2 = time.Date(2026, 5, 1, 9, 0, 0, 0, time.UTC)  // observation date
+)
+
+func storeAt(t *testing.T, store *Store, at time.Time, content string) *Memory {
+	t.Helper()
+	store.SetClock(func() time.Time { return at })
+	m := &Memory{Content: content, Type: TypeSemantic, Importance: 0.8}
+	if err := store.Store(context.Background(), m); err != nil {
+		t.Fatalf("Store: %v", err)
+	}
+	return m
+}
+
+func recallIDs(t *testing.T, store *Store, query string, filters Filters) map[string]bool {
+	t.Helper()
+	results, err := store.Recall(context.Background(), query, filters, 20)
+	if err != nil {
+		t.Fatalf("Recall: %v", err)
+	}
+	ids := make(map[string]bool, len(results))
+	for _, r := range results {
+		ids[r.Memory.ID] = true
+	}
+	return ids
+}
+
+// T1 — creation records when the knowledge was captured, and does NOT invent an
+// effective date.
+func TestHistoryCreationLeavesEffectiveDateUnknown(t *testing.T) {
+	store := newTestStore(t)
+	m := storeAt(t, store, histT0, "le volet du salon se ferme apres le coucher")
+
+	if m.ValidFrom != nil {
+		t.Fatalf("valid_from must stay nil when the effective date is unknown, got %v", m.ValidFrom)
+	}
+	if !m.CreatedAt.Equal(histT0) {
+		t.Fatalf("created_at must record the knowledge date, got %v", m.CreatedAt)
+	}
+	if revs, err := store.Revisions(context.Background(), m.ID); err != nil || len(revs) != 0 {
+		t.Fatalf("a new record has no revision (err=%v, n=%d)", err, len(revs))
+	}
+}
+
+// T2 — correcting the wording keeps the same record, records one revision and
+// leaves the validity untouched.
+func TestHistoryCorrectionKeepsIdentityAndRecordsRevision(t *testing.T) {
+	store := newTestStore(t)
+	m := storeAt(t, store, histT0, "le volet du salon se ferme 45 minutes apres le coucher")
+	before := m.UpdatedAt
+
+	store.SetClock(func() time.Time { return histT1 })
+	if err := store.Update(context.Background(), m.ID, Update{
+		Content: "le volet du salon se ferme 45 minutes apres le coucher du soleil",
+		Source:  RevisionSourceUpdateMemory,
+	}); err != nil {
+		t.Fatalf("Update: %v", err)
+	}
+
+	after, err := store.Get(m.ID)
+	if err != nil {
+		t.Fatalf("Get: %v", err)
+	}
+	if after.ValidFrom != nil || after.ValidUntil != nil {
+		t.Fatalf("a correction must not touch the validity window")
+	}
+	if !after.UpdatedAt.After(before) {
+		t.Fatalf("update should move updated_at")
+	}
+	revs, err := store.Revisions(context.Background(), m.ID)
+	if err != nil {
+		t.Fatalf("Revisions: %v", err)
+	}
+	if len(revs) != 1 {
+		t.Fatalf("exactly one revision expected, got %d", len(revs))
+	}
+	if !strings.Contains(revs[0].Content, "45 minutes") || revs[0].ReplacedByPath != RevisionSourceUpdateMemory {
+		t.Fatalf("revision must carry the prior text and its source, got %+v", revs[0])
+	}
+}
+
+// T5 — updating with the same text writes no revision.
+func TestHistoryNoRevisionWithoutContentChange(t *testing.T) {
+	store := newTestStore(t)
+	m := storeAt(t, store, histT0, "regle inchangee du volet du salon")
+	store.SetClock(func() time.Time { return histT1 })
+	if err := store.Update(context.Background(), m.ID, Update{
+		Content:    "regle inchangee du volet du salon",
+		Importance: ptrFloat(0.9),
+	}); err != nil {
+		t.Fatalf("Update: %v", err)
+	}
+	revs, err := store.Revisions(context.Background(), m.ID)
+	if err != nil {
+		t.Fatalf("Revisions: %v", err)
+	}
+	if len(revs) != 0 {
+		t.Fatalf("no revision expected when the text is unchanged, got %d", len(revs))
+	}
+}
+
+// T3 — an evolution creates a new record, closes the old window and links both
+// sides; the old record leaves current recall but stays visible as of its own
+// period.
+func TestHistoryEvolutionSupersedesAndStaysReadable(t *testing.T) {
+	store := newTestStore(t)
+	old := storeAt(t, store, histT0, "regle volet salon seuil neuf pourcent")
+	store.SetClock(func() time.Time { return histT1 })
+	neu := storeAt(t, store, histT1, "regle volet salon seuil douze pourcent")
+
+	if _, err := store.MarkOutdatedWithMeta(context.Background(), old.ID, "seuil revu",
+		neu.ID, map[string]string{MetadataDecisionRef: "DEC-TEST-001"}); err != nil {
+		t.Fatalf("MarkOutdatedWithMeta: %v", err)
+	}
+
+	oldNow, err := store.Get(old.ID)
+	if err != nil {
+		t.Fatalf("Get old: %v", err)
+	}
+	if oldNow.SupersededBy != neu.ID {
+		t.Fatalf("superseded_by must point at the successor, got %q", oldNow.SupersededBy)
+	}
+	if oldNow.ValidUntil == nil || !oldNow.ValidUntil.Equal(histT1) {
+		t.Fatalf("valid_until must close at the replacement instant, got %v", oldNow.ValidUntil)
+	}
+	if oldNow.Metadata[MetadataDecisionRef] != "DEC-TEST-001" {
+		t.Fatalf("decision reference must be kept, got %q", oldNow.Metadata[MetadataDecisionRef])
+	}
+	if oldNow.Metadata[MetadataStatus] != "superseded" {
+		t.Fatalf("status must be superseded, got %q", oldNow.Metadata[MetadataStatus])
+	}
+
+	neuNow, err := store.Get(neu.ID)
+	if err != nil {
+		t.Fatalf("Get new: %v", err)
+	}
+	if neuNow.Replaces != old.ID {
+		t.Fatalf("successor must reference the replaced record, got %q", neuNow.Replaces)
+	}
+
+	current := recallIDs(t, store, "regle volet salon pourcent", Filters{})
+	if current[old.ID] {
+		t.Fatalf("a superseded record must not answer a current-state query")
+	}
+	if !current[neu.ID] {
+		t.Fatalf("the successor must answer")
+	}
+
+	past, err := store.RecallAsOf(context.Background(), "regle volet salon pourcent", histT0.Add(time.Hour), Filters{}, 10)
+	if err != nil {
+		t.Fatalf("RecallAsOf: %v", err)
+	}
+	foundOld, foundNew := false, false
+	for _, r := range past {
+		switch r.Memory.ID {
+		case old.ID:
+			foundOld = true
+		case neu.ID:
+			foundNew = true
+		}
+	}
+	if !foundOld {
+		t.Fatalf("the record valid at that date must be found")
+	}
+	if foundNew {
+		t.Fatalf("a record that did not exist yet must not answer an earlier date")
+	}
+}
+
+// T8 — as_of states its confidence: a record with no effective date is
+// undetermined, not confirmed.
+func TestHistoryAsOfFlagsUndeterminedValidity(t *testing.T) {
+	store := newTestStore(t)
+	m := storeAt(t, store, histT0, "regle sans date d effet connue")
+
+	results, err := store.RecallAsOf(context.Background(), "regle date effet", histT2, Filters{}, 10)
+	if err != nil {
+		t.Fatalf("RecallAsOf: %v", err)
+	}
+	if len(results) == 0 {
+		t.Fatalf("the record should be returned")
+	}
+	if got := results[0].Memory.Metadata[MetadataValidityState]; got != ValidityUndetermined {
+		t.Fatalf("validity_state must be %q, got %q", ValidityUndetermined, got)
+	}
+	if results[0].Memory.ID != m.ID {
+		t.Fatalf("unexpected record returned")
+	}
+}
+
+// T4 — a withdrawn decision is retired with status revoked and stays readable.
+func TestHistoryRevokedDecisionIsKept(t *testing.T) {
+	store := newTestStore(t)
+	m := storeAt(t, store, histT0, "decision test sur le volet du salon")
+	store.SetClock(func() time.Time { return histT1 })
+
+	if _, err := store.MarkOutdatedWithMeta(context.Background(), m.ID, "decision annulee",
+		"", map[string]string{MetadataStatus: "revoked", MetadataDecisionRef: "DEC-TEST-002"}); err != nil {
+		t.Fatalf("MarkOutdatedWithMeta: %v", err)
+	}
+
+	got, err := store.Get(m.ID)
+	if err != nil {
+		t.Fatalf("a revoked record must never be deleted: %v", err)
+	}
+	if got.Metadata[MetadataStatus] != "revoked" {
+		t.Fatalf("status must be revoked, got %q", got.Metadata[MetadataStatus])
+	}
+	if got.Metadata[MetadataDecisionRef] != "DEC-TEST-002" {
+		t.Fatalf("decision reference must be kept")
+	}
+}
+
+// T6 — deleting a successor must not resurrect the record it replaced.
+func TestHistoryDeletingSuccessorDoesNotResurrect(t *testing.T) {
+	store := newTestStore(t)
+	old := storeAt(t, store, histT0, "regle volet salon ancienne version")
+	store.SetClock(func() time.Time { return histT1 })
+	neu := storeAt(t, store, histT1, "regle volet salon nouvelle version")
+
+	if _, err := store.MarkOutdatedWithMeta(context.Background(), old.ID, "remplacee",
+		neu.ID, map[string]string{MetadataSupersededPermanently: "true"}); err != nil {
+		t.Fatalf("MarkOutdatedWithMeta: %v", err)
+	}
+	if err := store.Delete(context.Background(), neu.ID); err != nil {
+		t.Fatalf("Delete successor: %v", err)
+	}
+
+	ids := recallIDs(t, store, "regle volet salon version", Filters{})
+	if ids[old.ID] {
+		t.Fatalf("a permanently superseded record must not become current again")
+	}
+}
+
+// T12 — archiving retires without destroying, and keeps the text history.
+func TestHistoryArchiveKeepsRecordAndRevisions(t *testing.T) {
+	store := newTestStore(t)
+	m := storeAt(t, store, histT0, "note a archiver sur le volet du salon")
+	store.SetClock(func() time.Time { return histT1 })
+	if err := store.Update(context.Background(), m.ID, Update{
+		Content: "note a archiver sur le volet du salon, corrigee",
+		Source:  RevisionSourceUpdateMemory,
+	}); err != nil {
+		t.Fatalf("Update: %v", err)
+	}
+
+	result, err := store.Archive(context.Background(), m.ID, "plus utile")
+	if err != nil {
+		t.Fatalf("Archive: %v", err)
+	}
+	if result.Status != "archived" {
+		t.Fatalf("status must be archived, got %q", result.Status)
+	}
+
+	got, err := store.Get(m.ID)
+	if err != nil {
+		t.Fatalf("an archived record must still exist: %v", err)
+	}
+	if got.Metadata["archived"] != "true" {
+		t.Fatalf("archived marker missing")
+	}
+	if revs, err := store.Revisions(context.Background(), m.ID); err != nil || len(revs) != 1 {
+		t.Fatalf("archiving must keep the revision history (err=%v, n=%d)", err, len(revs))
+	}
+	if recallIDs(t, store, "note archiver volet salon", Filters{})[m.ID] {
+		t.Fatalf("an archived record must not answer a current-state query")
+	}
+}
+
+// T9 — a closed validity window hides the record from current recall and
+// reopens it with include_expired.
+func TestHistoryExpiredHiddenUnlessRequested(t *testing.T) {
+	store := newTestStore(t)
+	store.SetClock(func() time.Time { return histT0 })
+	m := &Memory{
+		Content:    "regle temporaire du volet du salon",
+		Type:       TypeSemantic,
+		Importance: 0.8,
+		ValidUntil: ptrTime(histT1),
+	}
+	if err := store.Store(context.Background(), m); err != nil {
+		t.Fatalf("Store: %v", err)
+	}
+
+	store.SetClock(func() time.Time { return histT2 })
+	if recallIDs(t, store, "regle temporaire volet salon", Filters{})[m.ID] {
+		t.Fatalf("an expired record must not answer a current-state query")
+	}
+	if !recallIDs(t, store, "regle temporaire volet salon", Filters{IncludeExpired: true})[m.ID] {
+		t.Fatalf("include_expired must surface the record")
+	}
+}
+
+// T10 — the history is readable end to end: oldest first, prior text intact.
+func TestHistoryIsReadable(t *testing.T) {
+	store := newTestStore(t)
+	m := storeAt(t, store, histT0, "version un du reglage salon")
+	store.SetClock(func() time.Time { return histT1 })
+	if err := store.Update(context.Background(), m.ID, Update{
+		Content: "version deux du reglage salon",
+		Source:  RevisionSourceUpdateMemory,
+	}); err != nil {
+		t.Fatalf("Update: %v", err)
+	}
+
+	revs, err := store.Revisions(context.Background(), m.ID)
+	if err != nil {
+		t.Fatalf("Revisions: %v", err)
+	}
+	if len(revs) != 1 || revs[0].Revision != 1 {
+		t.Fatalf("expected revision #1, got %+v", revs)
+	}
+	if revs[0].Content != "version un du reglage salon" {
+		t.Fatalf("prior text must be preserved verbatim, got %q", revs[0].Content)
+	}
+}
+
+// T11 — evergreen is an explicit marker, never inferred from the type: it
+// cancels the calendar penalty while an ordinary record of the same type ages.
+func TestHistoryEvergreenCancelsDecay(t *testing.T) {
+	store := newTestStore(t)
+	store.SetRecallHalfLife(30)
+
+	aged := cachedMemory{
+		Type:      TypeSemantic,
+		CreatedAt: histT0,
+		Metadata:  map[string]string{MetadataEvergreen: "true"},
+	}
+	ordinary := cachedMemory{
+		Type:      TypeSemantic,
+		CreatedAt: histT0,
+		Metadata:  map[string]string{},
+	}
+	now := histT0.Add(365 * 24 * time.Hour)
+
+	if got := store.recallDecayMultiplier(&aged, now); got != 1.0 {
+		t.Fatalf("evergreen record must not decay, got %f", got)
+	}
+	if got := store.recallDecayMultiplier(&ordinary, now); got >= 1.0 {
+		t.Fatalf("an ordinary record must still decay, got %f", got)
+	}
+}
+
+func ptrFloat(v float64) *float64 { return &v }
+func ptrTime(t time.Time) *time.Time {
+	u := t.UTC()
+	return &u
+}
+
+// T13 — supersede writes the successor and closes the predecessor in one
+// commit: after the call, both rows exist, linked both ways.
+func TestSupersedeCreatesBothRowsAtomically(t *testing.T) {
+	store := newTestStore(t)
+	old := storeAt(t, store, histT0, "regle volet salon seuil neuf pourcent")
+	store.SetClock(func() time.Time { return histT1 })
+
+	successor := &Memory{Content: "regle volet salon seuil douze pourcent", Type: TypeSemantic, Importance: 0.8}
+	result, err := store.Supersede(context.Background(), old.ID, successor, "seuil revu", "DEC-TEST-010", true)
+	if err != nil {
+		t.Fatalf("Supersede: %v", err)
+	}
+	if result.SupersededBy != successor.ID {
+		t.Fatalf("result must point at the successor")
+	}
+
+	gotNew, err := store.Get(successor.ID)
+	if err != nil {
+		t.Fatalf("successor missing: %v", err)
+	}
+	gotOld, err := store.Get(old.ID)
+	if err != nil {
+		t.Fatalf("predecessor missing: %v", err)
+	}
+	if gotNew.Replaces != old.ID || gotNew.ValidFrom == nil {
+		t.Fatalf("successor must record replaces and valid_from")
+	}
+	if gotOld.SupersededBy != successor.ID || gotOld.ValidUntil == nil {
+		t.Fatalf("predecessor must be closed and linked")
+	}
+	if gotOld.Metadata[MetadataDecisionRef] != "DEC-TEST-010" || gotNew.Metadata[MetadataDecisionRef] != "DEC-TEST-010" {
+		t.Fatalf("decision reference must be on both sides")
+	}
+	if gotOld.Metadata[MetadataSupersededPermanently] != "true" {
+		t.Fatalf("permanent flag must be recorded")
+	}
+}
+
+// T14 — a refused supersede leaves nothing behind: no orphan successor.
+func TestSupersedeRefusalWritesNothing(t *testing.T) {
+	store := newTestStore(t)
+	old := storeAt(t, store, histT0, "regle volet salon version initiale")
+	store.SetClock(func() time.Time { return histT1 })
+	first := &Memory{Content: "regle volet salon version intermediaire", Type: TypeSemantic, Importance: 0.8}
+	if _, err := store.Supersede(context.Background(), old.ID, first, "premier remplacement", "DEC-TEST-011", false); err != nil {
+		t.Fatalf("first Supersede: %v", err)
+	}
+
+	before, _ := store.List(context.Background(), Filters{}, 100)
+	second := &Memory{Content: "regle volet salon version concurrente", Type: TypeSemantic, Importance: 0.8}
+	if _, err := store.Supersede(context.Background(), old.ID, second, "second remplacement", "DEC-TEST-012", false); err == nil {
+		t.Fatalf("superseding an already replaced record must fail")
+	}
+	after, _ := store.List(context.Background(), Filters{}, 100)
+	if len(after) != len(before) {
+		t.Fatalf("a refused supersede must not create a row: %d -> %d", len(before), len(after))
+	}
+	if _, err := store.Get(second.ID); err == nil {
+		t.Fatalf("the refused successor must not exist")
+	}
+}
+
+// T15 — an invalid successor is rejected before anything is written.
+func TestSupersedeRejectsInvalidSuccessor(t *testing.T) {
+	store := newTestStore(t)
+	old := storeAt(t, store, histT0, "regle volet salon a remplacer")
+	store.SetClock(func() time.Time { return histT1 })
+
+	if _, err := store.Supersede(context.Background(), old.ID, &Memory{Content: "", Type: TypeSemantic}, "vide", "", false); err == nil {
+		t.Fatalf("empty content must be refused")
+	}
+	got, err := store.Get(old.ID)
+	if err != nil {
+		t.Fatalf("predecessor must be untouched: %v", err)
+	}
+	if got.SupersededBy != "" || got.ValidUntil != nil {
+		t.Fatalf("a refused supersede must not close the predecessor")
+	}
+}
diff --git a/internal/memory/memory.go b/internal/memory/memory.go
index 2e81b1f..d82424c 100644
--- a/internal/memory/memory.go
+++ b/internal/memory/memory.go
@@ -830,6 +830,11 @@ type Filters struct {
 	Tags          []string  `json:"tags,omitempty"`
 	MinImportance float64   `json:"min_importance,omitempty"`
 	Since         time.Time `json:"since,omitempty"`
+	// IncludeExpired returns records whose validity window has already closed.
+	// Off by default: a closed window means the knowledge no longer describes
+	// the current state. The records are never deleted, only hidden — as_of and
+	// List still see them.
+	IncludeExpired bool `json:"include_expired,omitempty"`
 }
 
 // SearchResult wraps a Memory with its relevance score from a search query.
diff --git a/internal/memory/read.go b/internal/memory/read.go
index db71fd0..a5a47d0 100644
--- a/internal/memory/read.go
+++ b/internal/memory/read.go
@@ -214,6 +214,12 @@ func (ms *Store) recallDecayMultiplier(m *cachedMemory, now time.Time) float64 {
 	if lambda <= 0 {
 		return 1.0
 	}
+	// An explicit evergreen marker wins over every inference below. The rule
+	// "old is not false" cannot be satisfied by a calendar penalty: a verified
+	// rule of November is not stale in January, while an observed state is.
