@@ -0,0 +1,42 @@
+package server
+
+import (
+ "crypto/sha256"
+ "encoding/hex"
+ "encoding/json"
+ "strings"
+
+ "github.com/ipiton/agent-memory-mcp/internal/memory"
+ "github.com/ipiton/agent-memory-mcp/internal/sessionclose"
+)
+
+// reviewQueueProposalFingerprint hashes the complete candidate, not the
+// 220-character presentation excerpt. Source-session metadata is excluded:
+// identical proposals from different sessions must deduplicate.
+func reviewQueueProposalFingerprint(summary memory.SessionSummary, action sessionclose.CandidateAction) string {
+ type identity struct {
+  Context string `json:"context"`
+  Service string `json:"service"`
+  Kind string `json:"kind"`
+  EngineeringType string `json:"engineering_type"`
+  TargetMemoryID string `json:"target_memory_id"`
+  TargetTitle string `json:"target_title"`
+  CandidateTitle string `json:"candidate_title"`
+  CandidateContent string `json:"candidate_content"`
+ }
+ key := identity{
+  Context: strings.TrimSpace(summary.Context),
+  Service: strings.TrimSpace(summary.Service),
+  Kind: string(action.Kind),
+  EngineeringType: string(action.EngineeringType),
+  TargetMemoryID: strings.TrimSpace(action.TargetMemoryID),
+  TargetTitle: strings.TrimSpace(action.TargetTitle),
+ }
+ if action.Candidate != nil {
+  key.CandidateTitle = strings.TrimSpace(action.Candidate.Title)
+  key.CandidateContent = strings.TrimSpace(action.Candidate.Content)
+ }
+ payload, _ := json.Marshal(key)
+ digest := sha256.Sum256(append([]byte("maison-cognitive/review-proposal/v1\x00"), payload...))
+ return hex.EncodeToString(digest[:])
+}
