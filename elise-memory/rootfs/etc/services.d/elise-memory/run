#!/usr/bin/with-contenv bashio
set -e

CONFIG_PATH=/data/options.json

export ELISE_MEMORY_DB=/data/elise_memory.sqlite3
export ELISE_MEMORY_SYNC_ENABLED="$(bashio::config 'sync_enabled')"
export ELISE_MEMORY_GOOGLE_CREDENTIALS=/config/google-service-account.json
export ELISE_MEMORY_SHEET_HOME_ASSISTANT_ID="$(bashio::config 'sheet_home_assistant_id')"
export ELISE_MEMORY_SHEET_INDEX_ID="$(bashio::config 'sheet_index_id')"
export ELISE_MEMORY_SHEET_AUTOMATIONS_ID="$(bashio::config 'sheet_automations_id')"
export ELISE_MEMORY_SHEET_SCRIPTS_ID="$(bashio::config 'sheet_scripts_id')"

exec elise-memory
